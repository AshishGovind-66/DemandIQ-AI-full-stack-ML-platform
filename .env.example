# ==========================================
# DemandIQ AI - Environment Configuration
# ==========================================

# Environment: development | production | testing
ENVIRONMENT=development
DEBUG=True

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
# For local dev without Supabase, SQLite is used automatically if DATABASE_URL is unset
# Supabase PostgreSQL example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./demandiq.db

# Storage Directories
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODELS_DIR=./models
REPORTS_DIR=./reports

# Upload limits (bytes) - default 100MB
MAX_UPLOAD_SIZE_BYTES=104857600

# Frontend Next.js API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

